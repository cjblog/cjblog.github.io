---
import { deriveExcerpt } from '../lib/excerpt';
import { readingStats } from '../lib/reading-time';
import { formatDate, resolveUpdated } from '../lib/date';
import type { PostFrontmatter } from '../lib/schema';

interface Props {
  slug: string;
  data: PostFrontmatter;
  /** 正文 markdown，用来在构建期算字数、阅读时长与摘要 */
  body: string;
}

const { slug, data, body } = Astro.props;

const stats = readingStats(body);
const excerpt = deriveExcerpt(body, { summary: data.summary });
const published = formatDate(data.date);
const updated = formatDate(resolveUpdated(data.date, data.updated));
---

<li class="post-item">
  <h2 class="post-item__title">
    <a href={`/posts/${slug}/`}>{data.title}</a>
  </h2>

  {/*
    四项元信息用间距分组，不用中点分隔；数字统一等宽并加重一点，
    让一列文章的发布时间、字数能够纵向对齐。
  */}
  <p class="post-item__meta">
    <span><span class="post-meta__value">{published}</span> 发布</span>
    <span><span class="post-meta__value">{stats.wordCount.toLocaleString('zh-CN')}</span> 字</span>
    <span>更新于 <span class="post-meta__value">{updated}</span></span>
    <span>阅读 <span class="post-meta__value">{stats.label}</span></span>
  </p>

  {excerpt && <p class="post-item__excerpt">{excerpt}</p>}
</li>
