---
import { MODULES, SITE } from '../lib/site';
import type { ModuleId } from '../lib/site';

interface Props {
  /** 当前高亮模块。不传则都不高亮（例如 404 页不属于任何模块）。 */
  active?: ModuleId;
}

const { active } = Astro.props;
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-title" href="/">{SITE.title}</a>
    <nav class="site-nav" aria-label="站点模块">
      {
        MODULES.map((module) => (
          <a
            class="site-nav__link"
            href={`/${module.hash}`}
            data-module={module.id}
            aria-current={active === module.id ? 'true' : undefined}
          >
            {module.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
